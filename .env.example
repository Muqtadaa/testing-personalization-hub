# Environment variables for the Testing & Personalization Hub.
# Copy to .env.local for local development. EVERY variable is optional.
#
# ── SNAPSHOT MODE ────────────────────────────────────────────────────────────
# With NONE of these set, the app runs in "snapshot mode": it serves synthetic
# demo data bundled in src/data/snapshot/ when credentials are absent, the
# app-wide auth gate is off, and all write paths (Jira submit, Results upload)
# are disabled. The only variable worth setting for a demo is ANTHROPIC_API_KEY,
# which makes the Intake brief builder's AI features live.
# ─────────────────────────────────────────────────────────────────────────────

# Anthropic — powers the Intake brief builder, ideation, and roadmap ticket
# review. Without it those AI features fall back to a stub provider.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Jira — the LIVE roadmap feed and Intake→Jira submit/update. When ALL three are
# present the Roadmap goes live against Jira; when absent it serves the bundled
# snapshot (src/data/snapshot/roadmap.json) and submit/update are disabled.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_DRY_RUN=false

# Jira instance + project identifiers. Defaults are neutral placeholders; set
# these to match your Jira site. See src/lib/intake/config/jira-env.ts.
JIRA_CLOUD_ID=
JIRA_PROJECT_KEY=HUB
JIRA_PROJECT_ID=
JIRA_ISSUE_TYPE_ID=
JIRA_SERVICE_ACCOUNT_ID=

# Jira custom field ids (instance-specific, e.g. customfield_10001).
JIRA_FIELD_REQUEST_TYPE=
JIRA_FIELD_LINE_OF_BUSINESS=
JIRA_FIELD_JOURNEY=
JIRA_FIELD_RICE_REACH=
JIRA_FIELD_RICE_IMPACT=
JIRA_FIELD_RICE_EFFORT=
JIRA_FIELD_CATEGORY=
JIRA_FIELD_JOURNEY_PLATFORM=
JIRA_FIELD_RANK=

# Jira select-option ids (override only if your field options differ from the
# placeholder defaults). Names follow JIRA_OPT_<GROUP>_<VALUE>, for example:
#   JIRA_OPT_REQUEST_TYPE_AB_TEST / _PERSONALIZATION / _RESEARCH / _WORKSHOP
#   JIRA_OPT_LOB_ONLINE_STORE / _MARKETPLACE / _REWARDS_APP
#   JIRA_OPT_JOURNEY_ACQUISITION / _CONVERSION / _RETENTION
#   JIRA_OPT_RICE_REACH_HIGH / _MEDIUM / _LOW  (likewise RICE_IMPACT_*, RICE_EFFORT_*)
#   JIRA_OPT_CATEGORY_OPTIMIZATION / _PERSONALIZATION / _RESEARCH

# Sign-in allowlist: comma-separated email domains permitted to sign in and use
# Intake. Defaults to example.com.
ALLOWED_EMAIL_DOMAINS=example.com

# Supabase (server) — the Results dataset store and Intake draft persistence.
# When absent, Results serves the bundled snapshot (src/data/snapshot/results.json)
# read-only and Intake drafts live in memory only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase (public) — the app-wide email-OTP auth gate. When EITHER is absent the
# gate fails open (no login required) — this is how the public snapshot stays open.
# Set both (plus the server pair above) to re-enable the login wall.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Vercel Blob — raw file retention for Intake screenshots / SVG mockups and the
# Results workbook uploads. Optional; without it those uploads are unavailable.
BLOB_READ_WRITE_TOKEN=
